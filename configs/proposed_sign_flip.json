{
  "seed": 42,
  "device": "cuda",
  "dataset_name": "cifar10",
  "dataset_root": "./data",
  "num_nodes": 50,
  "rounds": 100,
  "local_epochs": 1,
  "batch_size": 64,
  "partition_mode": "noniid",
  "dirichlet_alpha": 0.5,
  "min_out_degree": 6,
  "max_out_degree": 12,
  "use_personalization": true,
  "use_malicious": true,
  "malicious_ratio": 0.2,
  "attack_type": "sign_flip",
  "attack_start_round": 20,
  "attack_scale": 2.0,
  "use_scaling_attack": false,
  "use_random_update_attack": false,
  "use_alie_attack": false,
  "use_slow_drift_attack": false,
  "use_layerwise_sign_flip_attack": false,
  "use_secure_privacy_module": true,
  "secure_num_share_holders": 3,
  "secure_shamir_threshold": 2,
  "secure_min_valid_contributors": 3,
  "secure_use_mpc_friendly_apt": true,
  "use_wandb": false,
  "wandb_mode": "disabled",
  "output_root": "./outputs"
}
