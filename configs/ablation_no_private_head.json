{
  "seed": 42,
  "device": "cuda",
  "dataset_name": "cifar10",
  "dataset_root": "./data",
  "num_nodes": 50,
  "rounds": 100,
  "local_epochs": 1,
  "batch_size": 64,
  "partition_mode": "noniid",
  "dirichlet_alpha": 0.5,
  "min_out_degree": 6,
  "max_out_degree": 12,
  "use_personalization": false,
  "use_malicious": false,
  "use_secure_privacy_module": true,
  "secure_num_share_holders": 3,
  "secure_shamir_threshold": 2,
  "secure_min_valid_contributors": 3,
  "secure_use_mpc_friendly_apt": true,
  "use_wandb": false,
  "wandb_mode": "disabled",
  "output_root": "./outputs"
}
